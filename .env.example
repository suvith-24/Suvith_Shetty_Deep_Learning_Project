# LexiSyncAI configuration. Copy to .env (run.ps1 does this automatically).
# No secrets are required: everything runs locally.

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Context window passed to Ollama; the default (2k-4k) can silently truncate evidence.
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=180
LEXISYNC_SEED=42

# --- Retrieval models (downloaded once from Hugging Face, then cached) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval parameters ---
LEXISYNC_CANDIDATE_K=20
LEXISYNC_TOP_K=5
LEXISYNC_PER_SUB_QUERY_K=3
LEXISYNC_RRF_K=60
LEXISYNC_CONTEXT_WINDOW=1
LEXISYNC_CONTEXTUAL_HEADERS=true
LEXISYNC_CHUNK_SIZE=1000
LEXISYNC_CHUNK_OVERLAP=150

# --- Grounding and abstention ---
# Cross-encoder logit below which the system abstains without calling the LLM.
LEXISYNC_EVIDENCE_GATE=0.0
LEXISYNC_HIGH_CONFIDENCE_SCORE=3.0
LEXISYNC_MAX_RETRIES=1
# hybrid = deterministic checks, LLM reviewer only when inconclusive; llm = always review
LEXISYNC_VERIFIER_MODE=hybrid

# --- OCR (Tesseract) ---
# auto = OCR scanned pages when Tesseract is installed; off = flag only
LEXISYNC_OCR=auto
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LEXISYNC_OCR_LANG=eng

# --- Upload limit ---
LEXISYNC_MAX_UPLOAD_MB=50
